{
  "name": "welc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode testing --port 5174",
    "build": "tsc -b && vite build --base=./",
    "release": "vite build --base=/welc/",
    "lint": "eslint .",
    "preview": "vite preview",
    "cypress": "cypress open",
    "e2e": "cypress run --browser chrome",
    "api": "cd api && .venv/bin/flask --env-file \"../.env.development\" run --debug --no-debugger -p 5172",
    "api:test": "cd api && .venv/bin/flask --env-file \"../.env.testing\" run -p 5171",
    "ci": "start-server-and-test api:test http-get://127.0.0.1:5171 dev:test http://localhost:5174 e2e",
    "vitest": "vitest"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "lodash": "^4.18.1",
    "music-metadata": "^11.12.3",
    "react": "^19.2.6",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cypress": "^15.21.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "pg": "^8.23.0",
    "sass": "^1.100.0",
    "start-server-and-test": "^3.0.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "cypress@15.21.1": true,
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true
  }
}
